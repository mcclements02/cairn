[ ${#UPDATED[@]} -gt 0 ] && { echo "   updated (${#UPDATED[@]}):";  printf '     ~ %s\n' "${UPDATED[@]}"; }
[ ${#SKIPPED[@]} -gt 0 ] && { echo "   kept (${#SKIPPED[@]}):";     printf '     = %s\n' "${SKIPPED[@]}"; }
