#!/usr/bin/env bash
# cairn — a shared, append-only ledger for repositories worked by more than one
# AI coding agent, plus the enforcement that keeps it honest.
#
#   cairn init   [--force] [--scripts-dir DIR] [--entry-file PATH] [--adopt-entry-file PATH] [PATH]
#                                                        install or re-sync a repo
#   cairn check  [--scripts-dir DIR] [PATH]             report drift; exit 1 if any
#   cairn status [--scripts-dir DIR] [PATH]             cross-worktree stranded work
#   cairn hooks  [--scripts-dir DIR] [PATH]             enable hooks in this clone
#   cairn resources [PATH]                              host-local RAM/process snapshot (read-only)
#   cairn help
set -euo pipefail

# Resolve a PATH-installed symlink too. `ln -s ~/.cairn/cairn /usr/local/bin/cairn`
# is the documented install path, and macOS lacks GNU readlink -f.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE")"
  case "$LINK_TARGET" in
    /*) SOURCE="$LINK_TARGET" ;;
    *)  SOURCE="$SOURCE_DIR/$LINK_TARGET" ;;
  esac
done
SELF="$(cd -P "$(dirname "$SOURCE")" && pwd)"
TEMPLATES="$SELF/templates"

usage() { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; }

CMD="${1:-help}"; [ $# -gt 0 ] && shift
case "$CMD" in
  init|check|status|hooks|resources) ;;
  help|-h|--help)          usage; exit 0 ;;
  *) echo "cairn: unknown command '$CMD'" >&2; echo >&2; usage >&2; exit 2 ;;
esac

CHECK=0; [ "$CMD" = "check" ] && CHECK=1
FORCE=0; SCRIPTS_DIR=""; TARGET=""
ENTRY_FILE_ARGS=(); ADOPT_ENTRY_FILE_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --force)
      [ "$CMD" = "init" ] || { echo "cairn $CMD: --force is only valid with init" >&2; exit 2; }
      FORCE=1; shift ;;
    --scripts-dir)
      [ -n "${2:-}" ] || { echo "cairn $CMD: --scripts-dir needs a value" >&2; exit 2; }
      SCRIPTS_DIR="$2"; shift 2 ;;
    --entry-file)
      [ "$CMD" = "init" ] || { echo "cairn $CMD: --entry-file is only valid with init" >&2; exit 2; }
      [ -n "${2:-}" ] || { echo "cairn init: --entry-file needs a value" >&2; exit 2; }
      ENTRY_FILE_ARGS+=("$2"); shift 2 ;;
    --adopt-entry-file)
      [ "$CMD" = "init" ] || { echo "cairn $CMD: --adopt-entry-file is only valid with init" >&2; exit 2; }
      [ -n "${2:-}" ] || { echo "cairn init: --adopt-entry-file needs a value" >&2; exit 2; }
      ADOPT_ENTRY_FILE_ARGS+=("$2"); shift 2 ;;
    -h|--help)     usage; exit 0 ;;
    -*)            echo "cairn $CMD: unknown flag: $1" >&2; exit 2 ;;
    *)
      [ -z "$TARGET" ] || { echo "cairn $CMD: only one repository path may be supplied" >&2; exit 2; }
      TARGET="$1"; shift ;;
  esac
done

[ -d "$TEMPLATES" ] || { echo "x  templates/ not found next to $0" >&2; exit 1; }

cd "${TARGET:-.}"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "x  not a git repository: $(pwd)" >&2; exit 1; }
cd "$ROOT"

# --- context -----------------------------------------------------------------
PROJECT_NAME="$(basename "$ROOT")"
if [ -z "$SCRIPTS_DIR" ]; then
  # A case-insensitive filesystem (macOS APFS, Windows NTFS) makes scripts/ and
  # Scripts/ the same inode, so `[ -d Scripts ]` is true even when the real
  # dirent is `scripts`. Ask git what casing it tracks, then fall back to find,
  # which string-compares the actual dirent. Never test with `-d`.
  SCRIPTS_DIR="$(git ls-files | sed -n 's|^\([Ss]cripts\)/.*|\1|p' | head -1)"
  if [ -z "$SCRIPTS_DIR" ]; then
    SCRIPTS_DIR="$(find . -maxdepth 1 -type d \( -name scripts -o -name Scripts \) \
                   -exec basename {} \; 2>/dev/null | head -1)"
  fi
  [ -z "$SCRIPTS_DIR" ] && SCRIPTS_DIR="scripts"
fi
BRANCH="$(git branch --show-current 2>/dev/null)"; [ -z "$BRANCH" ] && BRANCH="main"
DATE="$(date +%Y-%m-%d)"
ENTRY_FILE_REGISTRY=".cairn/entry-files"
ENTRY_FILE_TEMPLATE="$TEMPLATES/AGENT_ENTRY.md"

# --scripts-dir is rendered into scripts, workflow YAML, and .gitattributes,
# so it must be a boring, repo-contained directory rather than a shell or Git
# attributes pattern. This also prevents `../` and absolute writes escaping the
# repository during init.
valid_scripts_dir() {
  local dir="$1" folded
  case "$dir" in
    ""|/*|-*|\#*|[A-Za-z]:*|*\\*|.|..|*/|*//*|*$'\n'*|*$'\r'*|*[!A-Za-z0-9._/-]*) return 1 ;;
  esac
  case "/$dir/" in */./*|*/../*) return 1 ;; esac
  folded="$(printf '%s' "$dir" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
  case "$folded" in
    .git|.git/*|.cairn|.cairn/*|.githooks|.githooks/*|.github|.github/*) return 1 ;;
    agents.md|agents.md/*|ai_handoff.md|ai_handoff.md/*|ai_workspace.md|ai_workspace.md/*|\
    claude.md|claude.md/*|gemini.md|gemini.md/*|chatgpt.md|chatgpt.md/*|\
    .cairnignore|.cairnignore/*|.gitattributes|.gitattributes/*) return 1 ;;
  esac
  return 0
}

scripts_dir_path_is_safe() {
  local dir="$1" part="" component index=0 last_index
  local IFS='/'
  local -a components=()
  read -r -a components <<< "$dir"
  last_index=$(( ${#components[@]} - 1 ))
  for component in "${components[@]}"; do
    part="${part:+$part/}$component"
    [ -L "$part" ] && return 1
    if [ "$index" -lt "$last_index" ] && [ -e "$part" ] && [ ! -d "$part" ]; then
      return 1
    fi
    index=$((index + 1))
  done
  [ ! -e "$dir" ] || [ -d "$dir" ]
}

valid_scripts_dir "$SCRIPTS_DIR" && scripts_dir_path_is_safe "$SCRIPTS_DIR" || {
  echo "cairn $CMD: --scripts-dir must be a safe repository-relative directory: $SCRIPTS_DIR" >&2
  exit 2
}

sed_replacement() { printf '%s' "$1" | sed 's/[\\&|]/\\&/g'; }

# Templates are written LF-only (see .gitattributes). Strip any \r anyway, so a
# zip download or a clone made before those rules still produces working scripts
# instead of files bash rejects with "invalid option name".
render() { # render <template> -> stdout
  local scripts_dir project_name branch date
  scripts_dir="$(sed_replacement "$SCRIPTS_DIR")"
  project_name="$(sed_replacement "$PROJECT_NAME")"
  branch="$(sed_replacement "$BRANCH")"
  date="$(sed_replacement "$DATE")"
  sed -e 's/\r$//' \
      -e "s|__SCRIPTS_DIR__|$scripts_dir|g" \
      -e "s|__PROJECT_NAME__|$project_name|g" \
      -e "s|__BRANCH__|$branch|g" \
      -e "s|__DATE__|$date|g" "$1"
}

# --- delegating subcommands --------------------------------------------------
# status/hooks run the repo's own installed copy when present, so behaviour
# matches what CI and other clones execute. Fall back to the template.
run_installed() { # run_installed <basename> [args...]
  local name="$1" tmp rc
  shift
  if [ -f "$SCRIPTS_DIR/$name" ]; then bash "$SCRIPTS_DIR/$name" "$@"; return; fi
  tmp="$(mktemp)"; render "$TEMPLATES/scripts/$name" > "$tmp"
  bash "$tmp" "$@"; rc=$?; rm -f "$tmp"; return $rc
}

run_template() { # run_template <basename> [args...] — never trust repo content
  local name="$1" tmp rc
  shift
  tmp="$(mktemp)"; render "$TEMPLATES/scripts/$name" > "$tmp"
  bash "$tmp" "$@"; rc=$?; rm -f "$tmp"; return $rc
}
case "$CMD" in
  status) run_installed cairn-status.sh; exit $? ;;
  hooks)  run_installed cairn-hooks.sh;  exit $? ;;
  # This command promises a read-only host snapshot. Never execute a
  # repository-provided replacement when fulfilling that promise.
  resources) run_template cairn-resources.sh; exit $? ;;
esac

# --- ignore list -------------------------------------------------------------
# .cairnignore lists managed paths this repo has deliberately customized.
# Overwriting a considered local change is worse than leaving it drifted, so
# ignored paths are neither rewritten nor reported as drift.
IGNORE_FILE=".cairnignore"
is_ignored() {
  [ -f "$IGNORE_FILE" ] || return 1
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$IGNORE_FILE" | grep -qxF "$1"
}

CREATED=(); UPDATED=(); SKIPPED=(); DRIFT=(); MOVED=(); LEDGER_TOUCHED=0

# These blocks are the only regions cAIrn edits inside user-owned files.
BEGIN_MARK="<!-- CAIRN-LEDGER:BEGIN"
END_MARK="<!-- CAIRN-LEDGER:END -->"
LEGACY_BEGIN="<!-- AI-SYNC-LEDGER:BEGIN"
LEGACY_END="<!-- AI-SYNC-LEDGER:END -->"
ATTR_BEGIN="# CAIRN-GITATTRIBUTES:BEGIN"
ATTR_END="# CAIRN-GITATTRIBUTES:END"
AGENTS_BLOCK_INVALID=0
AGENTS_PATH_INVALID=0
LEDGER_PATH_INVALID=0

# --- optional agent entry files ---------------------------------------------
# AGENTS.md is the portable contract. Some agent runtimes only load a
# runtime-specific instruction file, though, so projects can register any
# repository-relative entry file in .cairn/entry-files. cAIrn manages only its
# marked block in those files; it never guesses an agent's filename or model.
ENTRY_BEGIN="<!-- CAIRN-ENTRY:BEGIN"
ENTRY_END="<!-- CAIRN-ENTRY:END -->"
ENTRY_FILES=(); ADOPT_ENTRY_FILES=(); ENTRY_FILE_COLLISIONS=(); ENTRY_REGISTRY_REPORTED=0

fold_entry_path() { printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'; }

valid_entry_file() { # valid_entry_file <repo-relative path>
  local entry="$1" folded scripts_folded
  case "$entry" in
    ""|/*|-*|\#*|[A-Za-z]:*|*\\*|.|..|*/|*//*|*$'\n'*|*$'\r'*) return 1 ;;
  esac
  case "/$entry/" in
    */./*|*/../*) return 1 ;;
  esac
  # Never let a configurable pointer replace cAIrn's core, Git metadata, hooks,
  # or an installed cAIrn script. The bundled root adapters are intentionally
  # allowed here: explicit --adopt-entry-file is the safe route for a project
  # that already owns one of those instruction files.
  folded="$(fold_entry_path "$entry")"
  scripts_folded="$(fold_entry_path "$SCRIPTS_DIR")"
  case "$folded" in
    .git|.git/*|.cairn|.cairn/*|.githooks|.githooks/*|.github/workflows/cairn.yml|\
    agents.md|ai_handoff.md|ai_workspace.md|.cairnignore|\
    "$scripts_folded"|"$scripts_folded"/*) return 1 ;;
  esac
  return 0
}

entry_file_path_is_safe() { # reject symlinks and non-directory parent components
  local entry="$1" part="" component index=0 last_index
  local IFS='/'
  local -a components=()
  read -r -a components <<< "$entry"
  last_index=$(( ${#components[@]} - 1 ))
  for component in "${components[@]}"; do
    part="${part:+$part/}$component"
    [ -L "$part" ] && return 1
    if [ "$index" -lt "$last_index" ] && [ -e "$part" ] && [ ! -d "$part" ]; then
      return 1
    fi
    index=$((index + 1))
  done
  return 0
}

entry_file_target_is_usable() { # a managed entry is a regular file, or new
  [ ! -e "$1" ] || [ -f "$1" ]
}

entry_file_registry_is_safe() {
  [ ! -L .cairn ] || return 1
  [ ! -L "$ENTRY_FILE_REGISTRY" ] || return 1
  [ ! -e .cairn ] || [ -d .cairn ] || return 1
  [ ! -e "$ENTRY_FILE_REGISTRY" ] || [ -f "$ENTRY_FILE_REGISTRY" ] || return 1
}

entry_file_management_requested() {
  local entry
  for entry in "${ENTRY_FILE_ARGS[@]:-}" "${ADOPT_ENTRY_FILE_ARGS[@]:-}"; do
    [ -z "$entry" ] || return 0
  done
  return 1
}

add_entry_file() { # add_entry_file <path> — preserve registry order, de-dupe
  local entry="$1" known entry_folded known_folded
  entry_folded="$(fold_entry_path "$entry")"
  for known in "${ENTRY_FILES[@]:-}"; do
    [ -z "$known" ] && continue
    [ "$known" = "$entry" ] && return
    known_folded="$(fold_entry_path "$known")"
    if [ "$known_folded" = "$entry_folded" ]; then
      ENTRY_FILE_COLLISIONS+=("$known <-> $entry")
      return
    fi
    # One entry cannot be both a file and the parent directory of another.
    # Detect this before any registry/core file is written, including on
    # case-insensitive APFS and Windows filesystems.
    if [[ "$entry_folded" == "$known_folded/"* || "$known_folded" == "$entry_folded/"* ]]; then
      ENTRY_FILE_COLLISIONS+=("$known <-> $entry (file/directory collision)")
      return
    fi
  done
  ENTRY_FILES+=("$entry")
}

mark_entry_file_for_adoption() {
  local entry="$1" known
  for known in "${ADOPT_ENTRY_FILES[@]:-}"; do
    [ -z "$known" ] && continue
    [ "$known" = "$entry" ] && return
  done
  ADOPT_ENTRY_FILES+=("$entry")
}

entry_file_is_adopted() {
  local entry="$1" known
  for known in "${ADOPT_ENTRY_FILES[@]:-}"; do
    [ -z "$known" ] && continue
    [ "$known" = "$entry" ] && return 0
  done
  return 1
}

html_marked_block_is_valid() { # file begin-prefix exact-end; exactly one block
  local file="$1" begin="$2" end="$3"
  awk -v b="$begin" -v e="$end" '
    {
      line=$0
      sub(/\r$/, "", line)
      has_begin=index(line,b)
      has_end=index(line,e)
    }
    has_begin {
      if (has_begin != 1 || has_end || line !~ /-->$/) invalid=1
      begins++
      if (inside || begins > 1) invalid=1
      inside=1
    }
    has_end {
      if (line != e) invalid=1
      ends++
      if (!inside || ends > 1) invalid=1
      inside=0
    }
    END { exit !(begins == 1 && ends == 1 && !inside && !invalid) }' "$file"
}

entry_file_has_cairn_block() { # exactly one complete block on dedicated lines
  html_marked_block_is_valid "$1" "$ENTRY_BEGIN" "$ENTRY_END"
}

entry_file_has_cairn_marker() {
  local entry="$1"
  grep -qF "$ENTRY_BEGIN" "$entry" || grep -qF "$ENTRY_END" "$entry"
}

agents_ledger_has_marker() {
  grep -qF "$BEGIN_MARK" AGENTS.md || grep -qF "$END_MARK" AGENTS.md \
    || grep -qF "$LEGACY_BEGIN" AGENTS.md || grep -qF "$LEGACY_END" AGENTS.md
}

agents_ledger_block_is_valid() {
  local current=0 legacy=0
  { grep -qF "$BEGIN_MARK" AGENTS.md || grep -qF "$END_MARK" AGENTS.md; } && current=1
  { grep -qF "$LEGACY_BEGIN" AGENTS.md || grep -qF "$LEGACY_END" AGENTS.md; } && legacy=1
  [ "$current" = "1" ] && [ "$legacy" = "1" ] && return 1
  [ "$current" = "1" ] && html_marked_block_is_valid AGENTS.md "$BEGIN_MARK" "$END_MARK" && return
  [ "$legacy" = "1" ] && html_marked_block_is_valid AGENTS.md "$LEGACY_BEGIN" "$LEGACY_END" && return
  return 1
}

preflight_agents_ledger() {
  [ "$AGENTS_PATH_INVALID" = "0" ] || return 0
  [ -f AGENTS.md ] || return 0
  agents_ledger_has_marker || return 0
  agents_ledger_block_is_valid && return 0
  AGENTS_BLOCK_INVALID=1
  if [ "$CHECK" = "1" ]; then
    DRIFT+=("AGENTS.md (must contain exactly one complete cAIrn ledger block)")
    return 0
  fi
  entry_file_error "AGENTS.md has an invalid cAIrn ledger block; refusing to overwrite it"
}

entry_file_mode() { # portable numeric mode, including set-id/sticky bits
  LC_ALL=C ls -ld "$1" | awk '
    {
      p=$1; mode=0
      if (substr(p,2,1)=="r") mode+=256
      if (substr(p,3,1)=="w") mode+=128
      c=substr(p,4,1); if (c=="x" || c=="s") mode+=64; if (c=="s" || c=="S") mode+=2048
      if (substr(p,5,1)=="r") mode+=32
      if (substr(p,6,1)=="w") mode+=16
      c=substr(p,7,1); if (c=="x" || c=="s") mode+=8; if (c=="s" || c=="S") mode+=1024
      if (substr(p,8,1)=="r") mode+=4
      if (substr(p,9,1)=="w") mode+=2
      c=substr(p,10,1); if (c=="x" || c=="t") mode+=1; if (c=="t" || c=="T") mode+=512
      printf "%o", mode
    }'
}

replace_entry_file_contents() { # replace <dest> with <prepared file>, preserve mode
  local dest="$1" source="$2" preserved mode
  mode="$(entry_file_mode "$dest")"
  preserved="$(mktemp "$(dirname "$dest")/.cairn-entry.XXXXXX")"
  if ! cp -p "$dest" "$preserved"; then
    rm -f "$preserved"
    entry_file_error "could not preserve metadata for $dest"
  fi
  if ! chmod u+w "$preserved"; then
    rm -f "$preserved"
    entry_file_error "could not make temporary entry copy writable for $dest"
  fi
  if ! cat "$source" > "$preserved"; then
    rm -f "$preserved"
    entry_file_error "could not update $dest while preserving its metadata"
  fi
  if ! chmod "$mode" "$preserved"; then
    rm -f "$preserved"
    entry_file_error "could not restore metadata for $dest"
  fi
  if ! mv "$preserved" "$dest"; then
    rm -f "$preserved"
    entry_file_error "could not replace $dest"
  fi
}

entry_file_error() {
  echo "x  cairn: $1" >&2
  exit 1
}

read_entry_file_registry() {
  local entry
  # .cairn is optional project-owned space. Leave it entirely alone unless an
  # entry registry already exists or this invocation explicitly manages one.
  if [ ! -e "$ENTRY_FILE_REGISTRY" ] && [ ! -L "$ENTRY_FILE_REGISTRY" ] \
     && ! entry_file_management_requested; then
    return 0
  fi
  entry_file_registry_is_safe || {
    if [ "$CHECK" = "1" ]; then
      DRIFT+=("$ENTRY_FILE_REGISTRY (must be a regular file under a real .cairn directory)")
      return 0
    fi
    entry_file_error "$ENTRY_FILE_REGISTRY must be a regular file under a real .cairn directory"
  }
  [ -f "$ENTRY_FILE_REGISTRY" ] || return 0
  while IFS= read -r entry || [ -n "$entry" ]; do
    entry="${entry%$'\r'}"
    case "$entry" in ""|\#*) continue ;; esac
    if ! valid_entry_file "$entry"; then
      if [ "$CHECK" = "1" ]; then
        DRIFT+=("$ENTRY_FILE_REGISTRY (invalid entry: $entry)")
        continue
      fi
      entry_file_error "$ENTRY_FILE_REGISTRY has an invalid entry: $entry"
    fi
    # An ignored managed path is intentionally local; do not inspect or follow
    # its target, matching .cairnignore's no-rewrite/no-drift contract.
    if is_ignored "$entry"; then
      add_entry_file "$entry"
      continue
    fi
    if ! entry_file_path_is_safe "$entry"; then
      if [ "$CHECK" = "1" ]; then
        DRIFT+=("$ENTRY_FILE_REGISTRY ($entry has an unsafe parent path)")
        continue
      fi
      entry_file_error "$ENTRY_FILE_REGISTRY entry has an unsafe parent path: $entry"
    fi
    if ! entry_file_target_is_usable "$entry"; then
      if [ "$CHECK" = "1" ]; then
        DRIFT+=("$ENTRY_FILE_REGISTRY ($entry is not a regular file)")
        continue
      fi
      entry_file_error "$ENTRY_FILE_REGISTRY entry is not a regular file: $entry"
    fi
    add_entry_file "$entry"
  done < "$ENTRY_FILE_REGISTRY"
}

validate_requested_entry_file() {
  local option="$1" entry="$2"
  valid_entry_file "$entry" || {
    echo "cairn init: $option needs a safe repository-relative path (not a core cAIrn file): $entry" >&2
    exit 2
  }
  entry_file_path_is_safe "$entry" || {
    echo "cairn init: $option may not traverse a symlink or non-directory: $entry" >&2
    exit 2
  }
  entry_file_target_is_usable "$entry" || {
    echo "cairn init: $option must name a regular file or a new path: $entry" >&2
    exit 2
  }
}

prepare_entry_files() {
  local entry
  read_entry_file_registry
  for entry in "${ENTRY_FILE_ARGS[@]:-}"; do
    [ -z "$entry" ] && continue
    validate_requested_entry_file "--entry-file" "$entry"
    add_entry_file "$entry"
  done
  for entry in "${ADOPT_ENTRY_FILE_ARGS[@]:-}"; do
    [ -z "$entry" ] && continue
    validate_requested_entry_file "--adopt-entry-file" "$entry"
    add_entry_file "$entry"
    mark_entry_file_for_adoption "$entry"
  done

  for entry in "${ENTRY_FILE_COLLISIONS[@]:-}"; do
    [ -z "$entry" ] && continue
    if [ "$CHECK" = "1" ]; then
      DRIFT+=("$ENTRY_FILE_REGISTRY (case-insensitive duplicate: $entry)")
    else
      entry_file_error "entry-file paths collide on case-insensitive filesystems: $entry"
    fi
  done

  # Fail before changing anything if a registered file has no valid single
  # cAIrn block. --adopt-entry-file only appends to a file with no markers.
  for entry in "${ENTRY_FILES[@]:-}"; do
    [ -z "$entry" ] && continue
    is_ignored "$entry" && continue
    if ! entry_file_target_is_usable "$entry"; then
      if [ "$CHECK" = "1" ]; then
        DRIFT+=("$entry (not a regular file)")
        continue
      fi
      entry_file_error "$entry is not a regular file"
    fi
    [ -e "$entry" ] || continue
    entry_file_has_cairn_block "$entry" && continue
    if entry_file_is_adopted "$entry" && ! entry_file_has_cairn_marker "$entry"; then
      continue
    fi
    if [ "$CHECK" = "1" ]; then
      DRIFT+=("$entry (must contain exactly one cAIrn entry block)")
    else
      if entry_file_has_cairn_marker "$entry"; then
        entry_file_error "$entry has an invalid cAIrn entry block; refusing to overwrite it"
      fi
      entry_file_error "$entry has no cAIrn entry block; use --adopt-entry-file $entry to preserve it and append one"
    fi
  done
}

entry_file_is_registered() { # compare normalized registry lines (LF or CRLF)
  local wanted="$1" entry
  [ -f "$ENTRY_FILE_REGISTRY" ] || return 1
  while IFS= read -r entry || [ -n "$entry" ]; do
    entry="${entry%$'\r'}"
    [ "$entry" = "$wanted" ] && return 0
  done < "$ENTRY_FILE_REGISTRY"
  return 1
}

register_entry_file() {
  local entry="$1"
  entry_file_registry_is_safe || entry_file_error "$ENTRY_FILE_REGISTRY must be a regular file under a real .cairn directory"
  entry_file_is_registered "$entry" && return
  if [ ! -f "$ENTRY_FILE_REGISTRY" ]; then
    mkdir -p "$(dirname "$ENTRY_FILE_REGISTRY")"
    printf '%s\n' '# cAIrn agent entry files — one repository-relative path per line.' > "$ENTRY_FILE_REGISTRY"
    CREATED+=("$ENTRY_FILE_REGISTRY")
    ENTRY_REGISTRY_REPORTED=1
  fi
  printf '%s\n' "$entry" >> "$ENTRY_FILE_REGISTRY"
  if [ "$ENTRY_REGISTRY_REPORTED" = "0" ]; then
    UPDATED+=("$ENTRY_FILE_REGISTRY")
    ENTRY_REGISTRY_REPORTED=1
  fi
}

register_requested_entry_files() {
  local entry
  for entry in "${ENTRY_FILE_ARGS[@]:-}"; do
    [ -z "$entry" ] || register_entry_file "$entry"
  done
  for entry in "${ADOPT_ENTRY_FILE_ARGS[@]:-}"; do
    [ -z "$entry" ] || register_entry_file "$entry"
  done
}

managed_path_is_safe() { # missing or regular, never a symlink or symlinked parent
  local path="$1"
  entry_file_path_is_safe "$path" && ! [ -L "$path" ] \
    && { [ ! -e "$path" ] || [ -f "$path" ]; }
}

report_unsafe_managed_path() {
  local path="$1"
  if [ "$CHECK" = "1" ]; then
    DRIFT+=("$path (must be a regular file below real directories)")
    return 0
  fi
  entry_file_error "$path must be a regular file below real directories; refusing to follow or replace it"
}

preflight_core_content_paths() {
  if ! managed_path_is_safe AGENTS.md; then
    AGENTS_PATH_INVALID=1
    report_unsafe_managed_path AGENTS.md
  fi
  if ! managed_path_is_safe AI_HANDOFF.md; then
    LEDGER_PATH_INVALID=1
    report_unsafe_managed_path AI_HANDOFF.md
  fi
}

preflight_legacy_paths() {
  local from to pair
  for pair in \
    "$SCRIPTS_DIR/ai-sync-install.sh:$SCRIPTS_DIR/cairn-hooks.sh" \
    "$SCRIPTS_DIR/ai-sync-status.sh:$SCRIPTS_DIR/cairn-status.sh" \
    "$SCRIPTS_DIR/ai-sync-ci-check.sh:$SCRIPTS_DIR/cairn-check.sh" \
    ".github/workflows/ai-sync.yml:.github/workflows/cairn.yml" \
    ".ai-sync-ignore:.cairnignore"
  do
    from="${pair%%:*}"; to="${pair##*:}"
    [ ! -e "$from" ] && ! [ -L "$from" ] && continue
    managed_path_is_safe "$from" || report_unsafe_managed_path "$from"
    managed_path_is_safe "$to" || report_unsafe_managed_path "$to"
  done
}

preflight_sync_paths() {
  local path
  # Validate every destination that sync_file or sync_gitattributes might write
  # before the first registry, migration, or template write. A late refusal is
  # not safe if an earlier file has already been installed.
  for path in \
    .gitattributes \
    "$SCRIPTS_DIR/cairn-hooks.sh" \
    "$SCRIPTS_DIR/cairn-status.sh" \
    "$SCRIPTS_DIR/cairn-check.sh" \
    "$SCRIPTS_DIR/cairn-resources.sh" \
    .github/workflows/cairn.yml \
    AI_WORKSPACE.md
  do
    is_ignored "$path" && continue
    managed_path_is_safe "$path" || report_unsafe_managed_path "$path"
  done
}

# --- migration from the pre-rename layout ------------------------------------
# Repos installed before the rename carry ai-sync-* names. Move them rather than
# leaving two parallel installs, and use git mv so history follows the file.
migrate_legacy() {
  local from to
  for pair in \
    "$SCRIPTS_DIR/ai-sync-install.sh:$SCRIPTS_DIR/cairn-hooks.sh" \
    "$SCRIPTS_DIR/ai-sync-status.sh:$SCRIPTS_DIR/cairn-status.sh" \
    "$SCRIPTS_DIR/ai-sync-ci-check.sh:$SCRIPTS_DIR/cairn-check.sh" \
    ".github/workflows/ai-sync.yml:.github/workflows/cairn.yml" \
    ".ai-sync-ignore:.cairnignore"
  do
    from="${pair%%:*}"; to="${pair##*:}"
    [ -f "$from" ] || continue
    [ -f "$to" ] && continue
    if [ "$CHECK" = "1" ]; then DRIFT+=("$from (legacy name; run 'cairn init')"); continue; fi
    if git ls-files --error-unmatch "$from" >/dev/null 2>&1; then
      git mv "$from" "$to"
    else
      mv "$from" "$to"
    fi
    MOVED+=("$from -> $to")
  done
  # The ledger's header points at the old script paths. Retarget ONLY the header:
  # everything from "## Log" down is append-only history, and a tool that enforces
  # append-only must not rewrite it. Stale paths inside past entries are correct —
  # that IS what the command was called when the entry was written.
  if [ "$CHECK" != "1" ] && [ -f AI_HANDOFF.md ] \
     && sed -n '1,/^## Log/p' AI_HANDOFF.md | grep -q "ai-sync-"; then
    perl -pi -e '
      BEGIN { $in_header = 1 }
      $in_header = 0 if /^## Log/;
      if ($in_header) {
        s|ai-sync-status\.sh|cairn-status.sh|g;
        s|ai-sync-install\.sh|cairn-hooks.sh|g;
        s|ai-sync-ci-check\.sh|cairn-check.sh|g;
      }' AI_HANDOFF.md
    UPDATED+=("AI_HANDOFF.md (header script paths; Log left intact)")
    LEDGER_TOUCHED=1
  fi
  # Older cAIrn headers named a fixed set of providers. Replace that header-only
  # wording so existing installs describe the same open protocol as new ones;
  # the append-only Log remains byte-for-byte intact.
  if [ "$CHECK" != "1" ] && [ -f AI_HANDOFF.md ] \
     && { sed -n '1,/^## Log/p' AI_HANDOFF.md | grep -qF "claude · gemini · chatgpt · copilot" \
          || sed -n '1,/^## Log/p' AI_HANDOFF.md | grep -qF "| Branch | Worktree | Agent | Status | Summary | Updated |"; }; then
    perl -pi -e '
      BEGIN { $in_header = 1 }
      $in_header = 0 if /^## Log/;
      if ($in_header) {
        s/AI agent\*\* \(claude · gemini · chatgpt · copilot\)\./AI agent, runtime, model, and human collaborator**./g;
        s/^\| Branch \| Worktree \| Agent \| Status \| Summary \| Updated \|$/| Branch | Worktree | Actor \/ runtime \/ model | Status | Summary | Updated |/;
        s/^\|--------\|----------\|-------\|--------\|---------\|---------\|$/|--------|----------|-------------------------|--------|---------|---------|/;
      }' AI_HANDOFF.md
    UPDATED+=("AI_HANDOFF.md (header actor wording; Log left intact)")
    LEDGER_TOUCHED=1
  fi
}
