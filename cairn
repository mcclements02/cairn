# registries, or managed files can be touched. No migration may follow a repo
# symlink or turn a malformed marker into truncation.
preflight_core_content_paths
preflight_legacy_paths
preflight_sync_paths
preflight_agents_ledger
prepare_entry_files
migrate_legacy
[ "$CHECK" = "1" ] || register_requested_entry_files

# --- file sync ---------------------------------------------------------------
sync_file() { # sync_file <template> <dest> [executable]
  local tpl="$1" dest="$2" exec_bit="${3:-}" tmp
  if is_ignored "$dest"; then SKIPPED+=("$dest (local override)"); return; fi
  if ! entry_file_path_is_safe "$dest" || [ -L "$dest" ] \
     || { [ -e "$dest" ] && [ ! -f "$dest" ]; }; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (must be a regular file below real directories)"); return; fi
    entry_file_error "$dest must be a regular file below real directories; refusing to follow or replace it"
  fi
  tmp="$(mktemp)"; render "$tpl" > "$tmp"
  if [ ! -f "$dest" ]; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (missing)"); rm -f "$tmp"; return; fi
    mkdir -p "$(dirname "$dest")"; mv "$tmp" "$dest"
    [ -n "$exec_bit" ] && chmod +x "$dest"; CREATED+=("$dest"); return
  fi
  if cmp -s "$tmp" "$dest"; then rm -f "$tmp"; return; fi
  if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (differs)"); rm -f "$tmp"; return; fi
  mv "$tmp" "$dest"; [ -n "$exec_bit" ] && chmod +x "$dest"; UPDATED+=("$dest")
}

cairn_hook_is_owned() {
  [ -f .githooks/pre-commit ] && ! [ -L .githooks/pre-commit ] \
    && awk '
      { line=$0; sub(/\r$/, "", line) }
      line == "# CAIRN-HOOK:BEGIN" {
        begins++
        if (NR != 5 || begins > 1) invalid=1
      }
      line == "# CAIRN-HOOK:END" {
        ends++
        if (ends > 1) invalid=1
        end_line=NR
      }
      END { exit !(begins == 1 && ends == 1 && end_line == NR && !invalid) }' .githooks/pre-commit
}

legacy_cairn_hook_is_owned() {
  [ -f .githooks/pre-commit ] && ! [ -L .githooks/pre-commit ] \
    && cmp -s <(render "$TEMPLATES/githooks/pre-commit.legacy") .githooks/pre-commit
}

sync_cairn_hook() { # never replace a project's existing pre-commit hook by surprise
  local dest=".githooks/pre-commit"
  if is_ignored "$dest"; then SKIPPED+=("$dest (local override)"); return; fi
  if [ -L .githooks ] || { [ -e .githooks ] && [ ! -d .githooks ]; }; then
    [ "$CHECK" = "1" ] || SKIPPED+=(".githooks (existing path preserved; not followed)")
    return
  fi
  if [ ! -e "$dest" ] && ! [ -L "$dest" ]; then
    sync_file "$TEMPLATES/githooks/pre-commit" "$dest" x
    return
  fi
  if cairn_hook_is_owned || legacy_cairn_hook_is_owned \
     || { [ "$FORCE" = "1" ] && [ "$CHECK" != "1" ] && [ -f "$dest" ] && ! [ -L "$dest" ]; }; then
    sync_file "$TEMPLATES/githooks/pre-commit" "$dest" x
    return
  fi
  [ "$CHECK" = "1" ] || SKIPPED+=("$dest (existing hook preserved; use --force to replace)")
}

sync_runtime_shim() { # create a bundled pointer without clobbering native rules
  local tpl="$1" dest="$2" tmp
  if is_ignored "$dest"; then SKIPPED+=("$dest (local override)"); return; fi
  # An explicitly registered root instruction file is managed by the generic
  # entry-file path below, not by a provider-specific convenience shim.
  if entry_file_is_registered "$dest"; then
    SKIPPED+=("$dest (managed as a registered entry file)")
    return
  fi
  tmp="$(mktemp)"; render "$tpl" > "$tmp"
  if [ ! -e "$dest" ] && ! [ -L "$dest" ]; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (missing)"); rm -f "$tmp"; return; fi
    mv "$tmp" "$dest"; CREATED+=("$dest"); return
  fi
  if [ -f "$dest" ] && ! [ -L "$dest" ] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"; return
  fi
  if [ "$FORCE" = "1" ] && [ "$CHECK" != "1" ] && [ -f "$dest" ] && ! [ -L "$dest" ]; then
    mv "$tmp" "$dest"; UPDATED+=("$dest (forced pointer replacement)"); return
  fi
  rm -f "$tmp"
  # A native instruction file can contain local rules that cAIrn cannot infer.
  # Preserve it by default; --adopt-entry-file is available for an explicit
  # cAIrn routing block, including these bundled root-file names.
  [ "$CHECK" = "1" ] || SKIPPED+=("$dest (existing instruction file preserved; use --force to replace or --adopt-entry-file to append a cAIrn block)")
}

gitattributes_has_cairn_marker() {
  grep -qF "$ATTR_BEGIN" .gitattributes || grep -qF "$ATTR_END" .gitattributes
}

gitattributes_has_cairn_block() {
  awk -v b="$ATTR_BEGIN" -v e="$ATTR_END" '
    {
      line=$0
      sub(/\r$/, "", line)
    }
    index(line, b) {
      if (line != b) invalid=1
      begins++
      if (inside || begins > 1) invalid=1
      inside=1
    }
    index(line, e) {
      if (line != e) invalid=1
      ends++
      if (!inside || ends > 1) invalid=1
      inside=0
    }
    END { exit !(begins == 1 && ends == 1 && !inside && !invalid) }' .gitattributes
}

sync_gitattributes() { # merge only cAIrn's marked LF-protection block
  local dest=".gitattributes" block current out
  if is_ignored "$dest"; then SKIPPED+=("$dest (local override)"); return; fi
  block="$(mktemp)"; render "$TEMPLATES/GITATTRIBUTES.cairn-block" > "$block"
  if [ ! -e "$dest" ] && ! [ -L "$dest" ]; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (missing cAIrn LF block)"); rm -f "$block"; return; fi
    mv "$block" "$dest"; CREATED+=("$dest"); return
  fi
  if [ -L "$dest" ] || [ ! -f "$dest" ]; then
    rm -f "$block"
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (must be a regular file)"); return; fi
    entry_file_error "$dest must be a regular file; refusing to follow or replace it"
  fi
  if ! gitattributes_has_cairn_marker; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (missing cAIrn LF block)"); rm -f "$block"; return; fi
    out="$(mktemp)"
    cat "$dest" > "$out"
    [ ! -s "$dest" ] || printf '\n' >> "$out"
    cat "$block" >> "$out"
    replace_entry_file_contents "$dest" "$out"
    rm -f "$block" "$out"; UPDATED+=("$dest (cAIrn LF block appended)"); return
  fi
  if ! gitattributes_has_cairn_block; then
    rm -f "$block"
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (invalid cAIrn LF block)"); return; fi
    entry_file_error "$dest has an invalid cAIrn LF block; refusing to overwrite it"
  fi
  current="$(mktemp)"
  awk -v b="$ATTR_BEGIN" -v e="$ATTR_END" '
    {
      line=$0
      sub(/\r$/, "", line)
    }
    line == b { inside=1 }
    inside { print line }
    line == e { exit }' "$dest" > "$current"
  if cmp -s "$block" "$current"; then rm -f "$block" "$current"; return; fi
  if [ "$CHECK" = "1" ]; then
    DRIFT+=("$dest (cAIrn LF block differs)")
    rm -f "$block" "$current"; return
  fi
  out="$(mktemp)"
  awk -v b="$ATTR_BEGIN" -v e="$ATTR_END" -v repl="$block" '
    {
      line=$0
      sub(/\r$/, "", line)
    }
    line == b { while ((getline replacement < repl) > 0) print replacement; close(repl); inside=1; next }
    inside && line == e { inside=0; next }
    !inside { print }' "$dest" > "$out"
  replace_entry_file_contents "$dest" "$out"
  rm -f "$block" "$current" "$out"; UPDATED+=("$dest (cAIrn LF block)")
}

sync_entry_file() { # sync_entry_file <registered repo-relative path>
  local dest="$1" tmp current out
  if is_ignored "$dest"; then SKIPPED+=("$dest (local override)"); return; fi
  entry_file_path_is_safe "$dest" || entry_file_error "$dest has an unsafe parent path"
  entry_file_target_is_usable "$dest" || entry_file_error "$dest is not a regular file"
  tmp="$(mktemp)"; render "$ENTRY_FILE_TEMPLATE" > "$tmp"

  if [ ! -e "$dest" ]; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (missing)"); rm -f "$tmp"; return; fi
    mkdir -p "$(dirname "$dest")"; mv "$tmp" "$dest"; CREATED+=("$dest"); return
  fi

  if ! entry_file_has_cairn_block "$dest"; then
    if entry_file_is_adopted "$dest" && ! entry_file_has_cairn_marker "$dest"; then
      if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (missing cAIrn entry block)"); rm -f "$tmp"; return; fi
      out="$(mktemp)"
      if [ -s "$dest" ]; then
        cat "$dest" > "$out"
        printf '\n' >> "$out"
      fi
      cat "$tmp" >> "$out"
      replace_entry_file_contents "$dest" "$out"
      rm -f "$tmp" "$out"
      UPDATED+=("$dest (cAIrn entry block appended)")
      return
    fi
    # prepare_entry_files reports this before any normal init write. Keep this
    # guard for safety if the file changes while cAIrn is running.
    rm -f "$tmp"
    if [ "$CHECK" = "1" ]; then return; fi
    entry_file_error "$dest has an invalid cAIrn entry block while cAIrn was running"
  fi

  current="$(mktemp)"
  awk -v b="$ENTRY_BEGIN" -v e="$ENTRY_END" \
      'index($0,b){f=1} f{print} f && index($0,e){exit}' "$dest" | sed 's/\r$//' > "$current"
  if cmp -s "$tmp" "$current"; then rm -f "$tmp" "$current"; return; fi
  if [ "$CHECK" = "1" ]; then
    DRIFT+=("$dest (cAIrn entry block differs)")
    rm -f "$tmp" "$current"
    return
  fi
  out="$(mktemp)"
  awk -v b="$ENTRY_BEGIN" -v e="$ENTRY_END" -v repl="$tmp" '
    index($0,b){ while ((getline l < repl) > 0) print l; close(repl); f=1; next }
    f && index($0,e){f=0; next}
    !f { print }' "$dest" > "$out"
  replace_entry_file_contents "$dest" "$out"
  rm -f "$tmp" "$current" "$out"
  UPDATED+=("$dest (cAIrn entry block)")
}

seed_file() { # seed_file <template> <dest> — content files: seed once
  local tpl="$1" dest="$2"
  if ! entry_file_path_is_safe "$dest" || [ -L "$dest" ] \
     || { [ -e "$dest" ] && [ ! -f "$dest" ]; }; then
    if [ "$CHECK" = "1" ]; then DRIFT+=("$dest (must be a regular file below real directories)"); return; fi
    entry_file_error "$dest must be a regular file below real directories; refusing to follow or replace it"
  fi
  # `AI_HANDOFF.md` is append-only history. No generic force flag may erase it.
  if [ -f "$dest" ]; then SKIPPED+=("$dest (exists; content preserved)"); return; fi
  if [ "$CHECK" = "1" ]; then [ -f "$dest" ] || DRIFT+=("$dest (missing)"); return; fi
  render "$tpl" > "$dest"; CREATED+=("$dest")
}

ledger_has_required_sections() {
  awk '
    /^## Active Work[[:space:]]*$/ { active++ }
    /^## Log/ { log_section++ }
    END { exit !(active >= 1 && log_section >= 1) }' AI_HANDOFF.md
}

